<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Clu's signed-build entitlements (docs/chromium/m9.md section 4), merged into Chromium's app-entitlements.plist once
  BRANDING has a MAC_TEAM_ID (patch chrome-BUILD.gn.patch), and used by scripts/chromium/sign-dev.sh.
  web-browser.public-key-credential lets Clu use iCloud Keychain passkeys for any site; Apple grants it to a
  developer account on request, and it only works with a provisioning profile that includes it. The webauthn keychain group holds Chromium's Touch ID credentials.
-->
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>${CHROMIUM_TEAM_ID}.${CHROMIUM_BUNDLE_ID}</string>
	<key>com.apple.developer.team-identifier</key>
	<string>${CHROMIUM_TEAM_ID}</string>
	<key>keychain-access-groups</key>
	<array>
		<string>${CHROMIUM_TEAM_ID}.${CHROMIUM_BUNDLE_ID}.webauthn</string>
	</array>
	<key>com.apple.developer.web-browser.public-key-credential</key>
	<true/>
</dict>
</plist>
