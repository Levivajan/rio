import("//build/config/ui.gni")
import("//testing/test.gni")

# Clu's code in the Chromium tree (docs/chromium/m2-shell.md). The product targets reach chrome through the hooks in
# chromium/patches; these targets collect the tests.

# Linked into Chromium's unit_tests and browser_tests (patch chrome-test-BUILD.gn.patch), so a full test build runs
# them with the rest, and into the two Clu test binaries below.
source_set("unit_tests") {
  testonly = true
  deps = [
    "//clu/browser/ai:unit_tests",
    "//clu/browser/capabilities:unit_tests",
    "//clu/browser/command:unit_tests",
    "//clu/browser/commands:unit_tests",
    "//clu/browser/data:unit_tests",
    "//clu/browser/importer:unit_tests",
    "//clu/browser/model:unit_tests",
    "//clu/browser/settings:unit_tests",
    "//clu/browser/multitask:unit_tests",
    "//clu/browser/site:unit_tests",
    "//clu/browser/spaces:unit_tests",
    "//clu/browser/theme:unit_tests",
    "//clu/browser/ui/views/frame:unit_tests",
    "//clu/browser/ui/webui:unit_tests",
    "//clu/browser/updater:unit_tests",
  ]
  if (is_mac) {
    deps += [ "//clu/browser/ui/cocoa:unit_tests" ]
  }
}

source_set("browser_tests") {
  testonly = true
  deps = [ "//clu/browser/ui/webui:browser_tests" ]
}

source_set("interactive_ui_tests") {
  testonly = true
  deps = [ "//clu/browser/ui/webui:interactive_ui_tests" ]
}

# Pure logic: layout math, payload caps, state JSON, URL rules, the tab tree and its rows, the archive rules, the key
# table and the main menu, Copy URL and the history index sync, the blocker's data and the Site tweak rules.
test("clu_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
  ]
}

# The CluShell* (PLAN M2), CluTabs* (M3), CluSpaces* (M4), CluCommand* and CluKeys* (M5), CluSplit*, CluPeek*,
# CluMini* and CluMedia* (M6), CluBlocker*, CluTweaks* and CluExtensions* (M7) browser tests, on Chromium's browser
# test runner.
test("clu_browsertests") {
  use_xvfb = use_xvfb_in_this_config
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  deps = [
    ":browser_tests",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/base:browser_tests_runner",
  ]
  data_deps = [ "//chrome:browser_tests_pak" ]
  if (is_mac) {
    data_deps += [
      "//chrome",
      "//chrome:chrome_framework",
    ]
  } else {
    data_deps += [ "//chrome:packed_resources" ]
  }
}

# The CluInteractive* tests (docs/chromium/interactive.md): real keyboard and mouse input from the OS, on Chromium's
# interactive UI test runner. They need real focus and a display of their own; scripts/chromium/test.sh --interactive
# runs them.
test("clu_interactive_ui_tests") {
  use_xvfb = use_xvfb_in_this_config
  deps = [
    ":interactive_ui_tests",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/base:interactive_ui_tests_runner",
  ]
  data_deps = [ "//chrome:browser_tests_pak" ]
  if (is_mac) {
    data_deps += [
      "//chrome",
      "//chrome:chrome_framework",
    ]
  } else {
    data_deps += [ "//chrome:packed_resources" ]
  }
}
