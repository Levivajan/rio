{
  "manifest_version": 3,
  "key": "",
  "name": "Clu Fixture",
  "version": "1.0.0",
  "description": "Fixture for Clu's extension tests.",
  "action": { "default_popup": "popup.html", "default_title": "Clu Fixture", "default_icon": { "32": "icon.png" } },
  "icons": { "32": "icon.png" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_start" }],
  "permissions": ["tabs"]
}
