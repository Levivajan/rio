# The per-call guard of every Clu WebUI handler: the generated allow-list and payload checks
# (scripts/chromium/gen-mojom.ts) and the helpers they call.
source_set("bridge") {
  sources = [
    "bridge/bridge_handlers.cc",
    "bridge/bridge_handlers.h",
    "bridge/bridge_validators.cc",
    "bridge/bridge_validators.h",
    "bridge/call_result.cc",
    "bridge/call_result.h",
    "bridge/validation.cc",
    "bridge/validation.h",
  ]
  public_deps = [
    "//base",
    "//clu/common/mojom",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
  ]
  deps = [ "//third_party/re2" ]
}

# The URL rules: which URLs the bridge opens and how state shows them. The tab model (//clu/browser/model) uses them
# for its rows.
source_set("url_policy") {
  sources = [
    "clu_url_policy.cc",
    "clu_url_policy.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    ":bridge",
    "//clu/common:urls",
    "//content/public/common",
    "//url",
  ]
}

# CluState JSON and the overlay geometry. No browser objects, so the unit tests run without a profile.
source_set("state") {
  sources = [
    "clu_overlay_rects.cc",
    "clu_overlay_rects.h",
    "clu_site_state.cc",
    "clu_site_state.h",
    "clu_state_builder.cc",
    "clu_state_builder.h",
  ]
  public_deps = [
    ":url_policy",
    "//base",
    "//clu/browser/capabilities:core",
    "//clu/browser/model:core",
    "//clu/browser/theme:core",
    "//clu/browser/multitask:core",
    "//clu/browser/ui/views/frame:layout_math",
    "//clu/browser/updater:rules",
    "//ui/gfx/geometry",
  ]
  deps = [
    ":bridge",
    "//clu/browser/spaces:core",
    "//url",
  ]
}

# The hover peek's timing rules (dwell, grace, guard) on a TickClock. No browser objects, so the unit tests run on a
# mock clock.
source_set("sidebar_peek") {
  sources = [
    "clu_sidebar_peek.cc",
    "clu_sidebar_peek.h",
  ]
  public_deps = [
    "//base",
    "//clu/browser/ui/views/frame:layout_math",
    "//ui/gfx/geometry",
  ]
}

# clu::IsPlaceholderTab() for the extensions tabs and windows APIs (patches chrome-browser-extensions-*). No deps, so
# //chrome/browser/extensions reaches no Clu code; //clu/browser/ui/webui implements it.
source_set("tab_hooks") {
  public = [ "clu_tab_hooks.h" ]
}

# The trackpad lift reports for the sidebar swipe. Only content and blink input types, so the unit tests link
# it without the whole WebUI.
source_set("wheel_lift_watcher") {
  sources = [
    "clu_wheel_lift_watcher.cc",
    "clu_wheel_lift_watcher.h",
  ]
  public_deps = [
    "//base",
    "//content/public/browser",
    "//third_party/blink/public/common",
  ]
  if (is_mac) {
    sources += [ "clu_wheel_lift_watcher_mac.mm" ]
    frameworks = [ "AppKit.framework" ]
  }
}

