# Chrome and sidebar-file import (docs/chromium/m8.md, docs/plan/07-data.md). `:core` is pure: the import
# rules, the Chrome Bookmarks and History readers, the sidebar-file parser, detection and the plan that turns
# imported trees into tab rows; `:service` runs imports against the profiles' models, HistoryService and
# CluSpacesService.

source_set("core") {
  sources = [
    "clu_arc_keychain.h",
    "clu_arc_keychain.mm",
    "clu_arc_secrets.cc",
    "clu_arc_secrets.h",
    "clu_chrome_bookmarks.cc",
    "clu_chrome_bookmarks.h",
    "clu_chrome_history.cc",
    "clu_chrome_history.h",
    "clu_import_detect.cc",
    "clu_import_detect.h",
    "clu_import_plan.cc",
    "clu_import_plan.h",
    "clu_import_rules.cc",
    "clu_import_rules.h",
    "clu_sidebar_file.cc",
    "clu_sidebar_file.h",
    "clu_site_data.cc",
    "clu_site_data.h",
  ]
  public_deps = [
    ":site_storage",
    "//base",
    "//clu/browser/model:core",
    "//clu/browser/theme:core",
  ]
  deps = [
    "//base:i18n",
    "//clu/browser/spaces:core",
    "//crypto",
    "//sql",
    "//third_party/boringssl",
    "//third_party/icu",
    "//url",
  ]
}

# Site storage staging and its merge at the next launch: no model or profile deps, so the startup hook in
# //clu/browser/model can call it before profiles load.
source_set("site_storage") {
  sources = [
    "clu_site_storage.cc",
    "clu_site_storage.h",
  ]
  public_deps = [ "//base" ]
  deps = [ "//third_party/leveldatabase" ]
}

