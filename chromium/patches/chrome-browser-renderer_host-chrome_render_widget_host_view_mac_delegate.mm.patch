+  // Clu: its frame and overlay WebUIs take hover as top chrome does; the
+  // overlays (the sidebar peek, hover cards, toasts) live in windows that are
+  // never key.
+  const GURL& clu_url = webContents->GetVisibleURL();
+  if (clu_url.SchemeIs(content::kChromeUIScheme) &&
+      (clu_url.host() == clu::kCluFrameHost ||
+       clu_url.host() == clu::kCluOverlayHost)) {
+    return AcceptMouseEvents::kWhenInActiveApp;
