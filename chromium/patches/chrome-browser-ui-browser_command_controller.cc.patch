 bool BrowserCommandController::SupportsCommand(int id) const {
+  // Clu: the IDC_CLU_* ids of Clu's main menu (docs/chromium/m5.md).
+  if (clu::SupportsCluCommand(browser_, id)) {
+    return true;
+  }
   return command_updater_->SupportsCommand(id);
 }
 
 bool BrowserCommandController::IsCommandEnabled(int id) const {
+  if (clu::SupportsCluCommand(browser_, id)) {
+    return clu::IsCluCommandEnabled(browser_, id);
+  }
+  // Clu: page commands follow a focused Peek, not the tab under it (m6.md).
+  bool clu_enabled = false;
+  if (clu::OverrideCommandEnabled(browser_, id, &clu_enabled)) {
+    return clu_enabled;
+  }
   return command_updater_->IsCommandEnabled(id);
 }
 
